# 複製為 .env 並填入實際值：cp .env.example .env

BOT_TOKEN=your_telegram_bot_token_here

# Docker 大檔上傳（Local Bot API）— 至 https://my.telegram.org 申請
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
LOCAL_BOT_API_URL=http://telegram-bot-api:8081/bot
OFFICIAL_MAX_FILE_SIZE_MB=50
LOCAL_MAX_FILE_SIZE_MB=500

# 本地 Windows 開發（Docker 內不需設定）
# FFMPEG_PATH=C:\path\to\ffmpeg\bin
